# Copy to .env and replace every placeholder before starting Aidora.
# Use a long, unique URL-safe password (letters and numbers) for DB_PASSWORD.
SECRET_KEY=replace-with-a-long-random-django-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=aidora
DB_USER=aidora
DB_PASSWORD=replace-with-a-long-unique-url-safe-password
DB_HOST=localhost
DB_PORT=5432
DATABASE_URL=postgresql://aidora:replace-with-a-long-unique-url-safe-password@localhost:5432/aidora

EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
BREVO_API_KEY=
BREVO_FROM_EMAIL=
SENTRY_DSN=
ENVIRONMENT=development
