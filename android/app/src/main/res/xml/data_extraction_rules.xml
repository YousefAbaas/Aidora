<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Preserve other app preferences; never restore device-bound secure-store ciphertext. -->
        <exclude domain="sharedpref" path="FlutterSecureStorage" />
        <!-- This legacy Flutter preferences file previously contained plaintext auth tokens. -->
        <exclude domain="sharedpref" path="FlutterSharedPreferences" />
    </cloud-backup>
    <device-transfer>
        <!-- Secure-store ciphertext is bound to the source device's Keystore key. -->
        <exclude domain="sharedpref" path="FlutterSecureStorage" />
        <!-- Legacy Flutter preferences may contain plaintext tokens on upgraded installs. -->
        <exclude domain="sharedpref" path="FlutterSharedPreferences" />
    </device-transfer>
</data-extraction-rules>
